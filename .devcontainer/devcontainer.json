{
  "name": "GITS Test Playground",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "remoteEnv": {
    "GITS_PLAYGROUND_ROOT": "${containerWorkspaceFolder}",
    "PATH": "${containerWorkspaceFolder}/.playground/bin:${containerWorkspaceFolder}/.playground/venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.cwd": "${workspaceFolder}/.playground/project",
        "python.defaultInterpreterPath": "${workspaceFolder}/.playground/venv/bin/python"
      }
    },
    "codespaces": {
      "openFiles": [
        "README.md",
        ".playground/project/setup.manifest"
      ]
    }
  },
  "waitFor": "postCreateCommand"
}
